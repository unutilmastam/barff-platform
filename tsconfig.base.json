{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "BARFF workspace root",
  "extends": "@barff/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@barff/types": ["packages/types/src"],
      "@barff/types/*": ["packages/types/src/*"],
      "@barff/ui": ["packages/ui/src"],
      "@barff/ui/*": ["packages/ui/src/*"],
      "@barff/config": ["packages/config/src"],
      "@barff/config/*": ["packages/config/src/*"],
      "@barff/validation": ["packages/validation/src"],
      "@barff/validation/*": ["packages/validation/src/*"],
      "@barff/utils": ["packages/utils/src"],
      "@barff/utils/*": ["packages/utils/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo", "build", "coverage"]
}
