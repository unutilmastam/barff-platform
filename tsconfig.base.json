{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "BARFF base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    "baseUrl": ".",
    "paths": {
      "@barff/types": ["packages/types/src"],
      "@barff/types/*": ["packages/types/src/*"],
      "@barff/ui": ["packages/ui/src"],
      "@barff/ui/*": ["packages/ui/src/*"],
      "@barff/config": ["packages/config/src"],
      "@barff/config/*": ["packages/config/src/*"],
      "@barff/validation": ["packages/validation/src"],
      "@barff/validation/*": ["packages/validation/src/*"],
      "@barff/utils": ["packages/utils/src"],
      "@barff/utils/*": ["packages/utils/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo", "build", "coverage"]
}
