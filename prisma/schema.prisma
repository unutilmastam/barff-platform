// BARFF platform — core schema.
//
// Scope of S03: identity, authorization and the two cross-cutting tables
// (settings, audit). Products, dealers, orders, warehouse, delivery and finance
// arrive in their own steps and extend this file — see ROADMAP.md.
//
// Conventions
// - Model names are PascalCase singular; `@@map` gives the snake_case plural
//   table names listed in CLAUDE.md §10.
// - Field names are camelCase; `@map` gives snake_case columns.
// - Primary keys are UUIDs generated by the database.
// - Money never appears here yet; when it does it is an integer of minor units
//   (see `@barff/utils/money` and the S36 requirement).

generator client {
  provider = "prisma-client-js"

  // Explicit, and inside the service that consumes it, for two reasons.
  //
  // 1. Packaging. The default output lands in a pnpm virtual-store path that
  //    `pnpm deploy --prod` does not carry, so the production image started
  //    with "Cannot find module '.prisma/client/default'". Generating into the
  //    service directory means the artifact is copied with the package.
  // 2. Prisma deprecates the default output in 6 and removes it in 7.
  //
  // Generated code, never committed — see .gitignore. Run `pnpm db:generate`.
  output = "../services/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A person who can sign in. Dealers, drivers and staff are all users; what
/// they may do comes from their roles, never from a flag on this row.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Login identifier. Stored lowercase — `@barff/validation` lowercases before
  /// it ever reaches here, so a unique index is enough to prevent
  /// `Dealer@barff.uz` and `dealer@barff.uz` becoming two accounts.
  email String  @unique
  /// E.164, e.g. +998901234567. Optional: staff accounts may not have one.
  /// Postgres allows many NULLs under a unique index, so this stays unique
  /// without forcing a phone on every user.
  phone String? @unique

  /// Argon2id. Never a plaintext password, never logged (CLAUDE.md §12).
  passwordHash String @map("password_hash")

  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  /// Preferred language for notifications and emails (uz | ru | en).
  locale String @default("uz") @db.VarChar(2)

  /// Set false to suspend an account without deleting its history.
  isActive Boolean @default(true) @map("is_active")

  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  /// Login throttling (S04). Counters live on the row so a lockout survives a
  /// restart and cannot be cleared by rotating through API instances.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete. Orders and audit rows must keep pointing at a real user, so
  /// accounts are retired rather than removed.
  deletedAt DateTime? @map("deleted_at")

  roles           UserRole[]
  auditLogs       AuditLog[]      @relation("AuditActor")
  assignedRoles   UserRole[]      @relation("RoleAssignedBy")
  settingsUpdated SystemSetting[] @relation("SettingUpdatedBy")
  mediaUploaded   MediaAsset[]    @relation("MediaUploader")

  // users.email and users.phone are indexed by @unique above (CLAUDE.md §10).
  // This one keeps the common "active staff" listing off a sequential scan.
  @@index([isActive, deletedAt])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Authorization
// ---------------------------------------------------------------------------

/// A named bundle of permissions. The six system roles are seeded from
/// `Role` in `@barff/types`, so the API, the database and the frontends cannot
/// disagree about what an ADMIN is called.
model Role {
  id String @id @default(uuid()) @db.Uuid

  /// Matches `Role` in @barff/types: ADMIN | SALES | WAREHOUSE | LOGISTICS |
  /// DRIVER | DEALER.
  key         String  @unique
  name        String
  description String?

  /// System roles are seeded and referenced by key in code; deleting one would
  /// break authorization, so the API refuses to.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// A single capability, addressed as `resource:action` (e.g. `orders:read`).
///
/// Endpoints are guarded by permissions rather than by role names, so adding a
/// role later does not mean touching every controller.
model Permission {
  id String @id @default(uuid()) @db.Uuid

  /// `resource:action`, unique and stable — this string appears in
  /// `@Permissions()` decorators (S04).
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

/// Join table. A user may hold several roles (a warehouse lead who also does
/// dispatch), so this is many-to-many rather than a column on `users`.
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  assignedAt   DateTime @default(now()) @map("assigned_at")
  /// Who granted it. Role changes are audited (§23); this is the quick lookup.
  assignedById String?  @map("assigned_by_id") @db.Uuid

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------
//
// Localized text is stored as JSON shaped `{ uz, ru, en }` — the `LocalizedText`
// type in `@barff/types`. A column per language would mean a migration every
// time a language is added, and a join table would turn every product read into
// a second query for text that is always wanted.

enum ProductDocumentKind {
  CERTIFICATE
  SPECIFICATION
  SAFETY_DATA
  OTHER

  @@map("product_document_kind")
}

/// A grouping shown in navigation and used to filter `/products`.
model ProductCategory {
  id String @id @default(uuid()) @db.Uuid

  slug        String @unique
  /// Localized `{ uz, ru, en }`.
  name        Json
  description Json?

  /// Self-relation for sub-categories. One level is expected; the schema does
  /// not enforce a depth, because nothing yet says what the real taxonomy is.
  parentId String?           @map("parent_id") @db.Uuid
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@index([isActive, displayOrder])
  @@map("product_categories")
}

/// A product family — "pomegranate juice" — independent of the size it is sold in.
model Product {
  id String @id @default(uuid()) @db.Uuid

  /// URL segment for `/products/[slug]`. Unique and indexed (CLAUDE.md §10).
  /// Never changes once published: an edit breaks every existing link.
  slug String @unique

  categoryId String?          @map("category_id") @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Localized `{ uz, ru, en }`.
  name             Json
  shortDescription Json? @map("short_description")
  description      Json?
  /// ⚠ Legally required on the page if published, and not yet supplied by
  /// BARFF (docs/OPEN-QUESTIONS.md → Q-016). Nullable so nothing has to be
  /// invented to create a row.
  ingredients      Json?
  storage          Json?

  /// Free text, not an enum: the flavour list is not settled, and an enum
  /// would need a migration per new juice.
  flavor String?

  /// ⚠ Q-016. Days from production.
  shelfLifeDays Int? @map("shelf_life_days")

  /// Per-page SEO overrides `{ title, description }` per locale. S15 owns the
  /// defaults; this is only where an editor overrides them.
  seo Json?

  /// Draft by default. A product becomes visible on the public site only when
  /// somebody deliberately publishes it — the opposite default would put
  /// half-entered rows on barff.uz.
  isActive     Boolean   @default(false) @map("is_active")
  publishedAt  DateTime? @map("published_at")
  displayOrder Int       @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete: orders reference variants, so a hard delete would orphan
  /// order history.
  deletedAt DateTime? @map("deleted_at")

  variants  ProductVariant[]
  images    ProductImage[]
  documents ProductDocument[]

  @@index([isActive, displayOrder])
  @@index([categoryId])
  @@map("products")
}

/// A sellable unit — one volume of one product.
model ProductVariant {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// CLAUDE.md §10 asks for an index on `products.sku`. It lives here instead:
  /// a SKU identifies a sellable unit, so a product sold in 350 ml and 1 L has
  /// two of them. On `products` the second one would have nowhere to go.
  ///
  /// ⚠ Nullable until BARFF supplies the real codes (Q-016).
  sku     String? @unique
  barcode String? @unique

  volumeMl Int  @map("volume_ml")
  /// Units per case, for dealer ordering. ⚠ Q-006.
  packSize Int? @map("pack_size")

  /// Nutrition per 100 ml, localized labels resolved at render time. ⚠ Q-016.
  nutrition Json?

  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  prices ProductPrice[]

  @@index([productId, displayOrder])
  @@map("product_variants")
}

/// Ordered gallery entry pointing at a `MediaAsset`.
model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Restricted rather than cascaded: deleting a media asset that a product
  /// still shows should fail loudly, not silently empty the gallery.
  mediaAssetId String     @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset @relation("ProductImages", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  /// Overrides the asset's own alt text where the product needs something more
  /// specific than the library entry.
  altText Json? @map("alt_text")

  /// Exactly one primary image per product, enforced by the service.
  isPrimary    Boolean @default(false) @map("is_primary")
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, mediaAssetId])
  @@index([productId, displayOrder])
  @@map("product_images")
}

/// Certificate or specification attached to a product.
model ProductDocument {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mediaAssetId String     @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset @relation("ProductDocuments", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  kind  ProductDocumentKind @default(OTHER)
  /// Localized `{ uz, ru, en }`.
  title Json

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, mediaAssetId])
  @@index([productId, displayOrder])
  @@map("product_documents")
}

/// A price for a variant.
///
/// Deliberately minimal at this step. Dealer tiers, regional prices, volume
/// discounts and promotions are the pricing engine's job (S23), and modelling
/// them now would encode a commercial policy BARFF has not supplied (Q-006).
model ProductPrice {
  id String @id @default(uuid()) @db.Uuid

  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Integer minor units — never a float. See `@barff/utils/money`.
  amountMinor Int    @map("amount_minor")
  currency    String @default("UZS") @db.VarChar(3)

  /// Open-ended when null. Overlapping windows are resolved by S23's resolver,
  /// which is the single place a price is ever computed.
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([variantId, isActive, validFrom])
  @@map("product_prices")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  DOCUMENT
  VIDEO

  @@map("media_kind")
}

enum MediaVisibility {
  /// Signed URL only, short-lived. The default for everything.
  PRIVATE
  /// Served through the CDN. Only for content deliberately published.
  PUBLIC

  @@map("media_visibility")
}

/// A file in object storage, with the metadata needed to serve it.
///
/// The row is written only after the bytes are stored, so a row always
/// describes something that exists. The reverse — an orphaned object with no
/// row — is recoverable by a sweep; a row pointing at nothing is a broken page.
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid

  /// Path in the bucket. Generated server-side, never derived from the
  /// uploaded filename — a client-supplied name is a path-traversal vector.
  storageKey String @unique @map("storage_key")
  bucket     String

  /// Kept for display and download only. Never used to build a path, and never
  /// trusted to say what the file is.
  originalFilename String @map("original_filename")
  /// Detected from the file's magic bytes, not from its extension or the
  /// Content-Type the client claimed (CLAUDE.md §20).
  mimeType         String @map("mime_type")
  sizeBytes        Int    @map("size_bytes")
  /// SHA-256 of the stored bytes — integrity checks and duplicate detection.
  checksum         String

  kind       MediaKind
  visibility MediaVisibility @default(PRIVATE)

  width       Int?
  height      Int?
  /// Tiny inline preview for `next/image` placeholder="blur", so a photo does
  /// not pop in against an empty box.
  blurDataUrl String? @map("blur_data_url")

  /// Derived renditions: `[{ label, key, format, width, height, sizeBytes }]`.
  /// JSON rather than a table: variants are always read with their parent and
  /// never queried on their own, so a join would buy nothing.
  variants Json?

  /// Localized alt text (uz/ru/en). Required before an image may be published
  /// on a public page (§19) — enforced by the CMS in S19, not by the column.
  altText Json? @map("alt_text")
  title   Json?

  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  productImages    ProductImage[]    @relation("ProductImages")
  productDocuments ProductDocument[] @relation("ProductDocuments")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete: a product or news article may still reference this row, and
  /// a hard delete would break the page rather than the link.
  deletedAt DateTime? @map("deleted_at")

  @@index([kind, deletedAt])
  @@index([createdAt])
  @@index([checksum])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

/// Runtime configuration an admin can change without a deploy.
///
/// Not a place for secrets: connection strings and API keys come from the
/// environment and AWS Secrets Manager (§12). `isPublic` marks the handful of
/// values the public website may read.
model SystemSetting {
  id String @id @default(uuid()) @db.Uuid

  key         String  @unique
  /// JSON so a setting can be a string, a number, a flag or a structure
  /// without a migration per shape.
  value       Json
  description String?

  /// Exposed through the public API when true. Default false: a setting is
  /// private unless someone decides otherwise.
  isPublic Boolean @default(false) @map("is_public")

  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Append-only record of sensitive operations (CLAUDE.md §23).
///
/// Rows are never updated or deleted by application code. `before`/`after` hold
/// safe fields only — the writer redacts passwords, hashes and tokens before
/// they reach this table, because an audit log is exactly the place a leaked
/// credential would survive longest.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Nullable: a failed login has no authenticated actor, and a user may be
  /// removed long after the action.
  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Snapshot of who acted, so the row still reads correctly if the account is
  /// later renamed or retired.
  actorEmail  String? @map("actor_email")

  /// e.g. `user.login`, `order.status_changed`, `stock.adjusted`.
  action   String
  /// Model name, e.g. `Order`.
  entity   String
  entityId String? @map("entity_id")

  before Json?
  after  Json?

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")
  /// Ties the row to the API response and the application logs.
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at")

  // "What happened to this order?" and "what did this user do?" are the two
  // questions the viewer (S38) is built around.
  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}
