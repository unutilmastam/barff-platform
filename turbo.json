{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env.example"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_TTL",
    "COOKIE_DOMAIN",
    "COOKIE_SECURE",
    "CORS_ALLOWED_ORIGINS",
    "API_HOST",
    "API_PORT",
    "API_PUBLIC_URL",
    "API_GLOBAL_PREFIX",
    "LOG_LEVEL",
    "LOGIN_MAX_ATTEMPTS",
    "LOGIN_LOCKOUT_SECONDS",
    "RATE_LIMIT_TTL",
    "RATE_LIMIT_LIMIT",
    "STORAGE_PROVIDER",
    "MEDIA_FILESYSTEM_ROOT",
    "MEDIA_MAX_UPLOAD_BYTES",
    "MEDIA_CDN_URL",
    "S3_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
