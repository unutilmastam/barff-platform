# =============================================================================
# BARFF.UZ — environment variable reference
# =============================================================================
# Names only. NEVER commit real values (CLAUDE.md §12).
# Copy to `.env` locally; use AWS Secrets Manager in staging/production.
# Keep separate databases, secrets, storage and keys per environment (§14).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=
LOG_LEVEL=

# --- API (services/api) ------------------------------------------------------
API_PORT=
API_HOST=
API_GLOBAL_PREFIX=
API_PUBLIC_URL=
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_TTL=
RATE_LIMIT_LIMIT=

# --- Frontend apps -----------------------------------------------------------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEALER_URL=
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_DELIVERY_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=
NEXT_PUBLIC_CDN_URL=

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Redis -------------------------------------------------------------------
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TLS=

# --- Object storage (S3 / MinIO locally) -------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_BUCKET_PUBLIC=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_SIGNED_URL_TTL=

# --- Auth / JWT (§12) --------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=
COOKIE_DOMAIN=
COOKIE_SECURE=
PASSWORD_HASH_MEMORY_COST=
PASSWORD_HASH_TIME_COST=
LOGIN_MAX_ATTEMPTS=
LOGIN_LOCKOUT_SECONDS=

# --- Seed admin (S03) --------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Notification providers (§21) --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# --- AWS (§13) ---------------------------------------------------------------
AWS_REGION=
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ECR_REPOSITORY=
ECS_CLUSTER=
ECS_SERVICE=

# --- Cloudflare --------------------------------------------------------------
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
