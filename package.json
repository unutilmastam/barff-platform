{
  "name": "barff-platform",
  "version": "0.0.0",
  "private": true,
  "description": "BARFF.UZ platform monorepo — public website, dealer portal, admin CMS, driver PWA and API.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . && turbo run lint",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "docker:build:api": "docker build -f services/api/Dockerfile -t barff-api:local ."
  },
  "devDependencies": {
    "@barff/config": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "^22.18.1",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.2.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "turbo": "^2.5.9",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
